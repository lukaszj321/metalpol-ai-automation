config:
  layout: dagre
  theme: base
  themeVariables:
    fontFamily: Inter, Segoe UI, Arial
    primaryColor: "#0F172A"
    primaryTextColor: "#E2E8F0"
    primaryBorderColor: "#334155"
    lineColor: "#94A3B8"
